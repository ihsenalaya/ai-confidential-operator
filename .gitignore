# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Kubernetes generated files - skip generated files, except vendored ones
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
.claude/
*.swp
*.swo
*~

# Secrets — never commit
.env
*.key
*secret*
*apikey*
*api-key*
kubeconfig*
*.tfstate
*.tfstate.*
*.tfplan
.terraform/
